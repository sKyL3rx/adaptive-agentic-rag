# ============================================================
# MODEL PROVIDER
# ============================================================

MODEL_PROVIDER=runpod

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

OPENAI_BASE_URL=https://api.openai.com/v1

RUNPOD_API_KEY=<YOUR_RUNPOD_API_KEY>


# ============================================================
# GLOBAL MODEL DEFAULTS
# ============================================================

OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=1024
OPENAI_TOP_P=1
OPENAI_PRESENCE_PENALTY=0
OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# COMPILER MODEL
# ============================================================

COMPILER_MODEL_PROVIDER=openai
COMPILER_MODEL=gpt-5.4-mini

COMPILER_MODEL_ID=

COMPILER_OPENAI_TEMPERATURE=0
COMPILER_OPENAI_TOP_P=1
COMPILER_OPENAI_MAX_TOKENS=256
COMPILER_OPENAI_PRESENCE_PENALTY=0
COMPILER_OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# CONTEXT RESOLVER MODEL
# ============================================================

CONTEXT_MODEL_PROVIDER=runpod
CONTEXT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
CONTEXT_MODEL_ID=<YOUR_RUNPOD_API_ID_MODEL>

CONTEXT_OPENAI_TEMPERATURE=0
CONTEXT_OPENAI_TOP_P=1
CONTEXT_OPENAI_MAX_TOKENS=256
CONTEXT_OPENAI_PRESENCE_PENALTY=0
CONTEXT_OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# RETRIEVAL PLANNER MODEL
# ============================================================

PLANNER_MODEL_PROVIDER=runpod
PLANNER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
PLANNER_MODEL_ID=<YOUR_RUNPOD_API_ID_MODEL>

PLANNER_OPENAI_TEMPERATURE=0
PLANNER_OPENAI_TOP_P=1
PLANNER_OPENAI_MAX_TOKENS=512
PLANNER_OPENAI_PRESENCE_PENALTY=0
PLANNER_OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# ANSWER GENERATOR MODEL
# ============================================================

ANSWER_MODEL_PROVIDER=runpod
ANSWER_MODEL=Qwen/Qwen3.6-27B-FP8
ANSWER_MODEL_ID=<YOUR_RUNPOD_API_ID_MODEL>

ANSWER_OPENAI_TEMPERATURE=0
ANSWER_OPENAI_TOP_P=1
ANSWER_OPENAI_MAX_TOKENS=1024
ANSWER_OPENAI_PRESENCE_PENALTY=0
ANSWER_OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# REVIEWER MODEL
# ============================================================

REVIEWER_MODEL_PROVIDER=runpod
REVIEWER_MODEL=Qwen/Qwen3.6-27B-FP8
REVIEWER_MODEL_ID=<YOUR_RUNPOD_API_ID_MODEL>

REVIEWER_OPENAI_TEMPERATURE=0
REVIEWER_OPENAI_TOP_P=1
REVIEWER_OPENAI_MAX_TOKENS=512
REVIEWER_OPENAI_PRESENCE_PENALTY=0
REVIEWER_OPENAI_FREQUENCY_PENALTY=0


# ============================================================
# WORKFLOW BUDGETS
# ============================================================

WORKFLOW_DEADLINE_MS=3000000

WORKFLOW_MAX_ITERATIONS=18

MAX_MODEL_CALLS=7

MAX_RETRIEVAL_ROUNDS=2
MAX_SUB_QUESTIONS=4


# ============================================================
# STAGE TIMEOUTS
# ============================================================

COMPILE_TIMEOUT_SECONDS=420
CONTEXT_TIMEOUT_SECONDS=420
PLAN_TIMEOUT_SECONDS=420
RETRIEVAL_TIMEOUT_SECONDS=420
ANSWER_TIMEOUT_SECONDS=420
VERIFY_TIMEOUT_SECONDS=420


# ============================================================
# RECENT HISTORY LIMITS
# ============================================================

COMPILE_HISTORY_MAX_TURNS=4
COMPILE_HISTORY_MAX_CHARS=1600

CONTEXT_HISTORY_MAX_TURNS=4
CONTEXT_HISTORY_MAX_CHARS=1600


# ============================================================
# RETRIEVAL POLICY
# ============================================================

SINGLE_TOP_K=5
BROAD_TOP_K=8
COMPLEX_TOP_K=4
RECOVERY_TOP_K=4

RETRIEVAL_CANDIDATE_MULTIPLIER=3

BROAD_MIN_EVIDENCE_ITEMS=2


# ============================================================
# PROMPT EVIDENCE LIMITS
# ============================================================

ANSWER_EVIDENCE_CHARS_PER_ITEM=1200
REVIEW_EVIDENCE_CHARS_PER_ITEM=1200


# ============================================================
# MCP RETRIEVAL CONNECTION
# ============================================================

MCP_URL=http://localhost:8002/mcp
MCP_TOOL_NAME=batch_semantic_search

RETRIEVAL_CORPUS_VERSION=dmv_ca_2025_v4_chunk450_overlap80

# Timeout transport MCP.
MCP_REQUEST_TIMEOUT_SECONDS=20

MCP_SSE_READ_TIMEOUT_SECONDS=300

ENABLE_MCP_DEBUG_LOGS=false


# ============================================================
# REDIS / SESSION HISTORY
# ============================================================

REDIS_URL=redis://localhost:6379/0


# ============================================================
# INPUT GUARDRAILS
# ============================================================

ENABLE_INPUT_GUARDRAILS=true

NEMO_URL=http://<YOUR_NEMO_GUARDRAILS_SERVICE>.guardrails-ms.svc.cluster.local:<PORT>
NEMO_GUARD_CONFIG_IN=<YOUR_INPUT_GUARD_CONFIG>
NEMO_GUARD_CONFIG_OUT=
NEMO_GUARD_CONFIG_INLINE=


# ============================================================
# OBSERVABILITY
# ============================================================

OTEL_ENABLED=true
OTEL_SDK_DISABLED=false

ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false

OTEL_SERVICE_NAME=rag-orchestrator
OTEL_SERVICE_VERSION=2.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=local

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true